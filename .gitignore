# Ignore intermediate build files and node_modules
node_modules/
**/node_modules/
target/
**/target/
__pycache__/
**/__pycache__/
*.pyc

# Local runtime data & logs
civbro.db
*.db
*.db-shm
*.db-wal
*.log
.DS_Store
.vscode/
.idea/

# Native binary (built per-machine)
*.so
*.so.*

# Frontend build output (built per-deploy)
dist/
**/dist/

# Ignore any dotenv / secrets files
.env
.env.*
*.secret
