# Keep runtime sources, dependency manifests/lockfiles, LICENSE/README and
# .github release automation. The shipped frontend/dist is required by WebUI.

# Local dependency environments and generated build intermediates
node_modules/
target/
build/
dist/
!frontend/dist/
!frontend/dist/**
venv/
.venv/
env/
.tox/
.nox/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.tsbuildinfo

# Native packages are downloaded/built for each installation, not committed
*.so
*.so.*
*.pyd
*.dll
*.dylib
*.whl
/backend/civbro_backend/civbro_core/
/backend/civbro_backend/.civbro-*/
/wheelhouse/

# Analysis artifacts and development tooling stay local; tests ship with
# the extension so the suite runs from any checkout.
/docs/
/screenshots/
/tools/
/artifacts*/
/benchmark*/
/backend/pytest.ini
/frontend/vitest.config.ts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.coverage
.coverage.*
coverage/
htmlcov/
playwright-report/
test-results/
*.prof
*.tmp
*.bak
*.old
*.orig
*.rej

# Runtime/user data must never enter a release
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.part
*.civitai.info
.env
.env.*
*.secret
*.pem
*.key

# Machine-specific editor, agent and OS files
.vscode/
.idea/
.agents/
.claude/
.opencode/
.playwright-mcp/
AGENTS.md
CLAUDE.md
MACHINE_TOPOLOGY.md
CONTEXT.md
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
